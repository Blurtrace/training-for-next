# =============================================================================
# BidHub — Environment Variables
# Copy this file to .env and fill in the values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Supabase / PostgreSQL
# Get these from: https://supabase.com → Project → Settings → Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.iymddefwxnpiujtokewh:WJ-yU9%3FThj!xbF%3F@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.iymddefwxnpiujtokewh:WJ-yU9%3FThj!xbF%3F@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# JWT — Access Token
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=54f437f8ca0512145c1aac0d0e297b635aaa5d2cf8a497fa53c0f03b191dc9cd1932dbfd346c6ef865702df330377570d349fc78e6038078fee72ade08be02ce
JWT_ACCESS_EXPIRES_IN=15m

# -----------------------------------------------------------------------------
# JWT — Refresh Token
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_REFRESH_SECRET=f9d02fa66be0cbb64b8bd025223eaabd12617479b52f16b64c66dc3ced243ff89517c783b1315d626636d7c20a174030113901523d147a1c19bfa6535e6ed73c
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Cookies
# -----------------------------------------------------------------------------
COOKIE_SECURE=true          # Set to false in local HTTP development
COOKIE_SAME_SITE=strict     # strict | lax | none

# -----------------------------------------------------------------------------
# Rate Limiting
# Choose one strategy: "db" (DB-backed counter table) or "upstash" (Redis).
# Leave the unused block empty / commented out.
# -----------------------------------------------------------------------------
RATE_LIMIT_STRATEGY=db      # db | upstash

# Upstash Redis (only when RATE_LIMIT_STRATEGY=upstash)
# Get these from: https://console.upstash.com → Database → REST API
UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_token

# Login rate limit window and max attempts
RATE_LIMIT_LOGIN_WINDOW_MS=900000   # 15 minutes in milliseconds
RATE_LIMIT_LOGIN_MAX=10

# Bid rate limit window and max attempts
RATE_LIMIT_BID_WINDOW_MS=60000      # 1 minute in milliseconds
RATE_LIMIT_BID_MAX=30

# -----------------------------------------------------------------------------
# Next.js — Public runtime variables (exposed to the browser, prefix NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BidHub

# -----------------------------------------------------------------------------
# Next.js — Server-only
# -----------------------------------------------------------------------------
NODE_ENV=development        # development | test | production

# -----------------------------------------------------------------------------
# Images — next/image remotePatterns
# Comma-separated hostnames allowed as image sources (e.g. Supabase Storage, CDN)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_IMAGE_HOSTNAME=<project-ref>.supabase.co

# -----------------------------------------------------------------------------
# Seed — default admin credentials (used only by the seed script, not in prod)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@bidhub.local
SEED_ADMIN_PASSWORD=Admin1234!

